Algoritmo Piramide
	Definir filas Como Entero
	Escribir "Ingresa el tamaño de la piramide"
	Leer filas
	
	Para i<-1 Hasta filas Con Paso 1 Hacer
		Para j<-1 Hasta filas-i Con Paso 1 Hacer
			Escribir Sin Saltar " "
		FinPara
		Para k<-1 Hasta (2*i)-1 Con Paso 1 Hacer
			Escribir Sin Saltar "*"
		FinPara
		Escribir " "
	Fin Para
FinAlgoritmo

